import * as React from 'react';

type Props = {|
  open: boolean,
  /**
   * url without protocol, for example '192.168.1.16:2929'
   */
  url: ?string,
  onClose: () => void,
  onExport: ?() => void,
  onRunPreviewLocally: () => void,
  error: ?any,
|};

declare export default React.ComponentType<Props>;
