import * as React from 'react';
import { type Tutorial } from '../Utils/GDevelopServices/Tutorial';

type TutorialState = {|
  tutorials: ?Array<Tutorial>,
  fetchTutorials: () => void,
  error: ?Error,
|};
type TutorialStateProviderProps = {|
  children: React.Node,
|};

declare export var TutorialContext: React.Context<TutorialState>;
declare export var TutorialStateProvider: React.ComponentType<TutorialStateProviderProps>;
