// @flow
// @flow-transitional-stub
import { type AiRequest } from '../Utils/GDevelopServices/Generation';

export type AskAiAutomationState = {|
  aiRequest: ?AiRequest,
  hasWorkInProgress: boolean,
  isSending: boolean,
  isSavingProject: boolean,
  lastSendError: ?Error,
  hasProject: boolean,
  hasUnfinishedPlan: boolean,
|};

export type AskAiAutomationDriver = {|
  startNewChat: () => void,
  startNewRequest: ({|
    userRequest: string,
    aiConfigurationPresetId: string,
  |}) => void,
  sendUserMessage: (userMessage: string) => Promise<void>,
  stop: () => Promise<void>,
  getState: () => AskAiAutomationState,
|};

declare export var registerAskAiAutomationDriver: (
  newDriver: AskAiAutomationDriver
) => () => void;

declare export var getAiToolsVersionOverride: () => string | null;

export type AutomatedAiRequestOptions = {|
  userRequest: string,
  aiConfigurationPresetId: string,
  toolsVersion: string | null,
  continueMessage: string,
  maxUserContinues: number,
  timeoutMs: number,
|};

declare export var DEFAULT_AI_REQUEST_CONTINUE_MESSAGE: string;
declare export var DEFAULT_AI_REQUEST_MAX_USER_CONTINUES: number;
declare export var DEFAULT_AI_REQUEST_TIMEOUT_MS: number;

export type AutomatedAiRequestStatus =
  | 'finished'
  | 'waiting_for_user'
  | 'error'
  | 'timeout';

export type AutomatedAiRequestResult = {|
  status: AutomatedAiRequestStatus,
  aiRequestId: string | null,
  aiRequestStatus: string | null,
  error: string | null,
  userContinuesCount: number,
  durationMs: number,
  hasProject: boolean,
  hasUnfinishedPlan: boolean,
|};

export type AutomatedAiRequestRun = {|
  getAiRequestId: () => string | null,
  getUserContinuesCount: () => number,
  getDurationMs: () => number,
  getResult: () => AutomatedAiRequestResult | null,
  promise: Promise<AutomatedAiRequestResult>,
|};

declare export var hasAiWorkedSinceLastUserMessage: (
  aiRequest: AiRequest
) => boolean;

declare export var isAiWorkDone: (state: AskAiAutomationState) => boolean;

declare export var getAutomatedAiRequestRun: () => AutomatedAiRequestRun | null;

declare export var startAutomatedAiRequest: (
  options: AutomatedAiRequestOptions
) => AutomatedAiRequestRun;

declare export var runAutomatedAiRequest: (
  options: AutomatedAiRequestOptions
) => Promise<AutomatedAiRequestResult>;
