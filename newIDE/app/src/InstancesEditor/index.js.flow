import { Component } from 'react';
import KeyboardShortcuts from '../UI/KeyboardShortcuts';
import ViewPosition from './ViewPosition';
import * as PIXI from 'pixi.js-legacy';
import * as THREE from 'three';
import InstancesAdder from './InstancesAdder';
import { type ScreenType } from '../UI/Responsive/ScreenTypeMeasurer';
import InstancesSelection from './InstancesSelection';
import { type InstancesEditorSettings } from './InstancesEditorSettings';
import Rectangle from '../Utils/Rectangle';
import { type TileMapTileSelection } from './TileSetVisualizer';

type Props = {|
  ...InstancesEditorPropsWithoutSizeAndScroll,
  width: number,
  height: number,
  onViewPositionChanged?: ViewPosition => void,
  onMouseMove?: MouseEvent => void,
  onMouseLeave?: MouseEvent => void,
  screenType: ScreenType,
  showObjectInstancesIn3D: boolean,
  showBasicProfilingCounters: boolean,
|};
type State = {|
  renderingError: null | {|
    error: Error,
    uniqueErrorId: string,
  |},
|};

declare export var instancesEditorId: string;
export type EditorViewPosition2D = {|
  viewX: number | null,
  viewY: number | null,
|};
export type InstancesEditorShortcutsCallbacks = {|
  onDelete: () => void,
  onCopy: () => void,
  onCut: () => void,
  onPaste: () => void,
  onDuplicate: () => void,
  onUndo: () => void,
  onRedo: () => void,
  onZoomOut: () => void,
  onZoomIn: () => void,
  onShift1: () => void,
  onShift2: () => void,
  onShift3: () => void,
  onFocusOnSelection: () => void,
|};
export type InstancesEditorPropsWithoutSizeAndScroll = {|
  project: gdProject,
  layout: gdLayout | null,
  eventsBasedObject: gdEventsBasedObject | null,
  eventsBasedObjectVariant: gdEventsBasedObjectVariant | null,
  layersContainer: gdLayersContainer,
  globalObjectsContainer: gdObjectsContainer | null,
  objectsContainer: gdObjectsContainer,
  chosenLayer: string,
  initialInstances: gdInitialInstancesContainer,
  instancesEditorSettings: InstancesEditorSettings,
  isInstanceOf3DObject: gdInitialInstance => boolean,
  onInstancesEditorSettingsMutated: (
    instancesEditorSettings: InstancesEditorSettings
  ) => void,
  instancesSelection: InstancesSelection,
  onInstancesAdded: (instances: Array<gdInitialInstance>) => void,
  onInstancesSelected: (instances: Array<gdInitialInstance>) => void,
  onInstanceDoubleClicked: (instance: gdInitialInstance) => void,
  onInstancesMoved: (instances: Array<gdInitialInstance>) => void,
  onInstancesResized: (instances: Array<gdInitialInstance>) => void,
  onInstancesRotated: (instances: Array<gdInitialInstance>) => void,
  selectedObjectNames: Array<string>,
  onContextMenu: (
    x: number,
    y: number,
    ignoreSelectedObjectNamesForContextMenu?: boolean
  ) => void,
  pauseRendering: boolean,
  instancesEditorShortcutsCallbacks: InstancesEditorShortcutsCallbacks,
  tileMapTileSelection: ?TileMapTileSelection,
  onSelectTileMapTile: (?TileMapTileSelection) => void,
  editorViewPosition2D: EditorViewPosition2D,
|};
declare export default class InstancesEditor extends Component<Props, State> {
  lastContextMenuX: number;
  lastContextMenuY: number;
  lastCursorX: number | null;
  lastCursorY: number | null;
  fpsLimiter: any;
  canvasArea: ?HTMLDivElement;
  // $FlowFixMe[value-as-type]
  pixiRenderer: PIXI.Renderer;
  // $FlowFixMe[value-as-type]
  threeRenderer: THREE.WebGLRenderer | null;
  keyboardShortcuts: KeyboardShortcuts;
  pinchHandler: any;
  canvasCursor: any;
  _instancesAdder: InstancesAdder;
  selectionRectangle: any;
  selectedInstances: any;
  tileMapPaintingPreview: any;
  clickInterceptor: any;
  highlightedInstance: any;
  hiddenInstancesDecorations: any;
  instancesResizer: any;
  instancesRotator: any;
  instancesMover: any;
  windowBorder: any;
  windowMask: any;
  statusBar: any;
  profilerBar: any;
  // $FlowFixMe[value-as-type]
  uiPixiContainer: PIXI.Container;
  // $FlowFixMe[value-as-type]
  backgroundPixiContainer: PIXI.Container;
  // $FlowFixMe[value-as-type]
  backgroundArea: PIXI.Container;
  instancesRenderer: any;
  viewPosition: ViewPosition;
  longTouchHandler: any;
  grid: any;
  background: any;
  _unmounted: boolean;
  _stopNativeAppActivity: (() => void) | null;
  _renderingPausedReasons: Set<string>;
  nextFrame: AnimationFrameID;
  contextMenuLongTouchTimeoutID: TimeoutID;
  hasCursorMovedSinceItIsDown: boolean;
  _instanceUnderPointerDown: gdInitialInstance | null;
  _isPointerOverCanvas: boolean;
  _showObjectInstancesIn3D: boolean;
  _previousToolBeforePicker: ?TileMapTileSelection;
  state: State;
  _initializeCanvasAndRenderer(): void;
  forceRemount: () => void;
  _mountEditorComponents(props: Props): void;
  _shouldHandleKeyboardShortcuts: () => boolean;
  resetInstanceRenderersFor: (objectName: string) => void;
  zoomBy: (value: number) => void;
  zoomOnCursorBy(value: number): void;
  getTileMapTileSelection: () => any;
  getSelectedInstancesObjectFillColor: (isLocked: boolean) => {| color: number, alpha: number |};
  shouldDisplayClickableHandles: () => any;
  getZoomFactor: () => any;
  setZoomFactor: (zoomFactor: number) => void;
  addSerializedInstances: (options: {|
    position: [number, number],
    copyReferential: [number, number],
    serializedInstances: Array<Object>,
    addInstancesInTheForeground?: boolean,
    doesObjectExistInContext: string => boolean,
  |}) => Array<gdInitialInstance>;
  snapSelection: (instances: gdInitialInstance[]) => void;
  addInstances: (pos: [number, number], objectNames: Array<string>, layer: string) => Array<gdInitialInstance>;
  _onMouseMove: (x: number, y: number) => void;
  _onInterceptClick: (sceneCoordinates: Array<{| x: number, y: number |}>) => void;
  getRendererOfInstance: (instance: gdInitialInstance) => any;
  _onDownBackground: (x: number, y: number, event?: PointerEvent) => void;
  _onPanMove: (deltaX: number, deltaY: number, x: number, y: number) => void;
  _getLayersLocks: () => any;
  _onUpBackground: (x: number, y: number, event?: PointerEvent) => void;
  _onPanEnd: () => void;
  _selectInstanceInsideSelectionRectangle: () => void;
  _onInstanceClicked: (instance: gdInitialInstance) => void;
  _onInstanceRightClicked: (coordinates: {|
    offsetX: number,
    offsetY: number,
    x: number,
    y: number,
  |}) => void;
  _onRightClicked: (arg0: {|
    offsetX: number,
    offsetY: number,
    x: number,
    y: number,
    ignoreSelectedObjectNamesForContextMenu?: boolean,
  |}) => void;
  _onInstanceDoubleClicked: (instance: gdInitialInstance) => void;
  _onOverInstance: (instance: gdInitialInstance) => void;
  _onDownInstance: (instance: gdInitialInstance, sceneX: number, sceneY: number) => void;
  _onOutInstance: (instance: gdInitialInstance) => void;
  _onUpInstance: (instance: gdInitialInstance, sceneX: number, sceneY: number) => void;
  _onMoveInstance: (instance: gdInitialInstance, deltaX: number, deltaY: number) => void;
  _onMoveInstanceEnd: () => void;
  _onResize: (deltaX: number, deltaY: number, grabbingLocation: any) => void;
  _onResizeEnd: () => void;
  _onRotate: (deltaX: number, deltaY: number) => void;
  _onRotateEnd: () => void;
  clearHighlightedInstance: () => void;
  _deleteTemporaryInstances: () => void;
  // $FlowFixMe[missing-local-annot]
  onInstancesMovedDebounced: any;
  moveSelection: (x: number, y: number) => void;
  cancelClickInterception: () => boolean;
  scrollBy(x: number, y: number): void;
  scrollTo(x: number, y: number): void;
  fitViewToRectangle(rectangle: Rectangle, arg1: {| adaptZoom: boolean |}): void;
  getBoundingClientRect(): any;
  getContentAABB: () => Rectangle | null;
  zoomToFitContent: () => void;
  _getAreaRectangle: () => Rectangle;
  zoomToInitialPosition: () => void;
  zoomToFitSelection: () => void;
  centerViewOnLastInstance: (instances: Array<gdInitialInstance>, offset?: ?[number, number]) => void;
  getLastContextMenuSceneCoordinates: () => any;
  getLastCursorSceneCoordinates: () => [number, number] | null;
  getCoordinatesToRenderTileMapPreview: () => any;
  getViewPosition: () => ?ViewPosition;
  _renderScene: () => void;
  pauseSceneRendering: (reason: string) => void;
  resumeSceneRendering: (reason: string) => void;
  getInstanceSize: (initialInstance: gdInitialInstance) => [number, number, number];
}
