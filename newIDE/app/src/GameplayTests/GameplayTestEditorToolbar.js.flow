import * as React from 'react';
import { type I18n as I18nType } from '@lingui/core';
import { type MenuItemTemplate } from '../UI/Menu/Menu.flow';

type Props = {|
  onRunTest: (options: GameplayTestRunSpeedOptions) => void | Promise<void>,
  onStopTest: () => void,
  isRunning: boolean,
  canRun: boolean,
  onToggleProperties: () => void,
  isPropertiesShown: boolean,
|};

export type GameplayTestRunSpeedOptions = {|
  // Game seconds simulated per real second (1 = normal speed, 4 = 4x...).
  // null: run as fast as possible.
  speedFactor: number | null,
|};
declare export var buildRunTestSpeedMenuTemplate: (i18n: I18nType, onRunTest: (options: GameplayTestRunSpeedOptions) => void | Promise<void>) => Array<MenuItemTemplate>;
declare export var Toolbar: React.ComponentType<Props>;
declare export default React.ComponentType<Props>;
