declare export var getAssetShortHeadersToDisplay: (allAssetShortHeaders: AssetShortHeader[], selectedFolders: string[], pageBreakIndex?: number) => AssetShortHeader[];
export type AssetsListInterface = {|
  getScrollPosition: () => number,
