|};

declare export var renderPriceFormatted: (priceInCents: number, currencyCode: 'USD' | 'EUR', i18n: I18nType) => string;
declare export var renderProductPrice: (arg0: FormatProps) => React.Node;
declare export var OwnedLabel: () => React.Node;
declare export var getProductPriceOrOwnedLabel: (arg0: ProductPriceOrOwnedProps) => React.Node;
