import { type SceneEventsOutsideEditorChanges, type InstancesOutsideEditorChanges, type ObjectsOutsideEditorChanges, type ObjectGroupsOutsideEditorChanges, type ExtensionsOutsideEditorChanges } from './OutsideEditorChanges';
import { type EventsFunctionsExtensionsState } from '../EventsFunctionsExtensionsLoader/EventsFunctionsExtensionsContext';

