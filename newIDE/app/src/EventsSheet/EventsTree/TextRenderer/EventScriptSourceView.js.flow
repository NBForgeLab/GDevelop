// @flow
// @flow-transitional-stub [Phase 5]

export type JsCodeExcerpt = {|
  eventId: string,
  fromLine: number,
  toLine: number,
  totalLines: number,
  code: string,
|};

type EventScriptRenderingError = {|
  path: string,
  message: string,
|};

export type EventScriptSourceView = {|
  text: string,
  selectedEventIds: Array<string>,
  jsCodeExcerpt: JsCodeExcerpt | null,
  truncated: boolean,
  notes: Array<string>,
  renderingErrors: Array<EventScriptRenderingError>,
|};

export type ScopeSummary = {|
  parameters: Array<{|
    name: string,
    type: string,
  |}>,
  properties: Array<string>,
  childObjects?: Array<string>,
  extensionVariables: {|
    global: Array<string>,
    scene: Array<string>,
  |},
|};

declare export var renderScopeSummaryHeaderLines: (
  scopeSummary: ScopeSummary
) => Array<string>;

declare export var formatNumberedLines: (
  lines: Array<string>,
  firstIndex: number
) => Array<string>;

declare export var renderEventSourceById: ({|
  eventsList: gdEventsList,
  eventIdOrGroupName: string,
  includeSubEvents: boolean,
|}) => string | null;

declare export var findEventByIdOrGroupName: ({|
  eventsList: gdEventsList,
  eventIdOrGroupName: string,
|}) => {|
  event: gdBaseEvent,
  path: string,
  indentation: string,
|} | null;

declare export var buildEventScriptSourceView: ({|
  eventsList: gdEventsList,
  eventIds?: ?Array<string>,
  searchText?: ?string,
  objectNames?: ?Array<string>,
  subEventsDepth?: ?number,
  maxChars: number,
  jsFromLine?: ?number,
|}) => EventScriptSourceView;
