  _onChooseLayer: (layerName: string) => void;
  _onSelectLayer: (layer: gdLayer | null) => void;
  _onSelectObjectGroup: (objectGroup: gdObjectGroup | null) => void;
  _onDeleteObjects: (i18n: I18nType, objectsWithContext: ObjectWithContext[], done: boolean => void) => void;
  _getValidatedObjectOrGroupName: (newName: string, global: boolean, i18n: I18nType) => any;
