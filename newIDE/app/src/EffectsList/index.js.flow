declare export var useEffectOverridingAlertDialog: () => ((
  existingEffectNames: Array<string>
) => Promise<boolean>);
declare export var getEnumeratedEffectMetadata: (allEffectDescriptions: Array<EnumeratedEffectMetadata>, effectType: string) => ?EnumeratedEffectMetadata;
