type UseManageEffectsState = {|
  allEffectMetadata: Array<EnumeratedEffectMetadata>,
  draggedEffect: {| current: ?gdEffect |},
  addEffect: (effectType: string) => void,
  onEffectAddedFromStore: (effect: gdEffect) => void,
