  moveEffect: (targetEffect: gdEffect) => void,
  pasteEffectsAtTheEnd: () => Promise<void>,
  pasteEffectsBefore: (effect: gdEffect) => Promise<void>,
  removeEffect: (effect: gdEffect) => void,
