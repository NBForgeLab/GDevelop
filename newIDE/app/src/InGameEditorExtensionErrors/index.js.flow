  key: string,
  extensionName: string | null,
  // `onCreated`, `doStepPostEvents`, `onHotReloading`, `onDestroy`,
  // `editorCallback` or `toolbar`.
  phase: string,
  // The object or behavior type running the code, if any.
  type: string | null,
  message: string,
  stack: string,
  count: number,
|};
declare export var setLatestInGameEditorExtensionErrors: (errors: Array<InGameEditorExtensionError>) => void;
declare export var getLatestInGameEditorExtensionErrors: () => Array<InGameEditorExtensionError>;
declare export var isInGameEditorExtensionErrorFromStore: (project: ?gdProject, arg1: InGameEditorExtensionError) => boolean;
declare export var buildInGameEditorExtensionErrorGameCrashReport: (project: gdProject, arg1: InGameEditorExtensionError) => GameCrashReport;
declare export var getInGameEditorExtensionErrorOrigin: (arg0: InGameEditorExtensionError) => string;
declare export var getInGameEditorExtensionErrorCallChain: (stack: string) => string | null;
declare export var getAskAiToFixInGameEditorExtensionErrorsText: (errors: Array<InGameEditorExtensionError>) => string;
declare export var addInGameEditorExtensionErrorsToFunctionCallOutputs: (arg0: {|
  functionCallOutputs: Array<AiRequestFunctionCallOutput>,
