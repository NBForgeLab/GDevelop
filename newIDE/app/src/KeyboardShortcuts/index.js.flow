import { type CommandName } from '../CommandPalette/CommandsList';
import { type ShortcutMap } from './DefaultShortcuts';
import { type PreviewDebuggerServer } from '../ExportAndShare/PreviewLauncher.flow';

type KeyEventLike = {
  +keyCode?: number,
  +which?: any,
  +code?: string,
  +metaKey: boolean,
  +ctrlKey: boolean,
  +altKey: boolean,
  +shiftKey: boolean,
};
type UseKeyboardShortcutsProps = {|
  onRunCommand: (commandName: CommandName) => void,
  previewDebuggerServer: ?PreviewDebuggerServer,
  targetDocument?: Document, // For external windows — defaults to window.document
  ignoreHandledByElectron?: boolean, // For external windows where Electron menu IPC doesn't reach
|};

declare export var getShortcutStringFromEvent: (e: KeyEventLike) => string;
declare export var isValidShortcutEvent: (e: KeyEventLike) => boolean;
declare export var getShortcutMetadataFromEvent: (e: KeyEventLike) => {| shortcutString: string, isValid: boolean |};
declare export var useShortcutMap: () => ShortcutMap;
declare export var useKeyboardShortcuts: (arg0: UseKeyboardShortcutsProps) => void;
declare export var getShortcutDisplayName: (shortcutString: ?string) => string;
declare export var getElectronAccelerator: (shortcutString: string) => string;
