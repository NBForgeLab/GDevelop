export type CommandArea = $Keys<typeof commandAreas>;
declare export var getDisplayedCommandAreaNames: () => Array<CommandArea>;
declare export var getCommandNamesHandledByInGameEditor: () => Array<CommandName>;
declare export default { [CommandName]: CommandMetadata };
