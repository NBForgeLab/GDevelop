// @flow
// @flow-transitional-stub

declare export var createOrUpdateResource: (project: gdProject, newlyCreatedResource: gdResource, resourceName: string) => void;
declare export var getLocalResourceFullPath: (project: gdProject, resourceName: string) => string;
declare export var isPathInProjectFolder: (project: gdProject, resourcePath: string) => boolean;
declare export var copyAllToProjectFolder: (project: gdProject, resourcePaths: Array<string>, newToOldFilePaths: Map<string, string>) => Promise<Array<string>>;
declare export var getResourceFilePathStatus: (project: gdProject, resourceName: string) => string;
declare export var applyResourceDefaults: (project: gdProject, newResource: gdResource) => void;
declare export var withResourcesRenamer: (project: gdProject, resourceNewNames: { [string]: string }, exposeResources: gdResourcesRenamer => void) => void;
declare export var renameResourcesInProject: (project: gdProject, resourceNewNames: { [string]: string }) => void;
declare export var parseLocalFilePathOrExtensionFromMetadata: (resource: gdResource) => {|
  localFilePath: ?string,
  extension: ?string,
|};
declare export var updateResourceJsonMetadata: (resource: gdResource, newMetadata: { [string]: any }) => void;
declare export var RESOURCE_CUSTOM_PROPERTIES_METADATA_KEY: string;
export type ResourceCustomPropertyValue = string | number | boolean;
declare export var getResourceCustomProperties: (resource: gdResource) => { [string]: ResourceCustomPropertyValue };
declare export var getResourceCustomPropertyValue: (resource: gdResource, name: string, defaultValue: ?ResourceCustomPropertyValue) => ?ResourceCustomPropertyValue;
declare export var setResourceCustomPropertyValue: (resource: gdResource, name: string, value: ResourceCustomPropertyValue) => void;
declare export var isFetchableUrl: (url: string) => boolean;
declare export var isURL: (filename: string) => boolean;
declare export var isBlobURL: (filename: string) => boolean;
