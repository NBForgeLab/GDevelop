declare export var extensionConfigurationRootFolderId: string;
declare export var extensionObjectsRootFolderId: string;
declare export var extensionBehaviorsRootFolderId: string;
declare export var extensionFunctionsRootFolderId: string;
declare export var extensionTestsRootFolderId: string;
declare export var getTreeViewItemIdFromFunctionFolderOrFunction: (functionFolderOrFunction: gdFunctionFolderOrFunction) => string;
declare export var getRootId: (eventsBasedBehavior?: ?gdEventsBasedBehavior, eventsBasedObject?: ?gdEventsBasedObject) => string;
declare export var getRootFunctionFolderId: (eventsBasedBehavior?: ?gdEventsBasedBehavior, eventsBasedObject?: ?gdEventsBasedObject) => string;
declare export var getRootFunctionFolder: (eventsFunctionsExtension: gdEventsFunctionsExtension, eventsBasedBehavior?: ?gdEventsBasedBehavior, eventsBasedObject?: ?gdEventsBasedObject) => gdFunctionFolderOrFunction;
export interface TreeViewItemContent {
  getName(): string | React.Node;
  getId(): string;
  getHtmlId(index: number): ?string;
  getThumbnail(): ?string;
  getDataset(): ?HTMLDataset;
  onSelect(): void;
  onClick(): void;
  buildMenuTemplate(i18n: I18nType, index: number): Array<MenuItemTemplate>;
  getRightButton(i18n: I18nType): ?MenuButton;
  renderRightComponent(i18n: I18nType): ?React.Node;
  rename(newName: string): void;
  edit(): void;
  delete(): void;
  copy(): void;
  paste(): void;
  cut(): void;
  getIndex(): number;
  moveAt(
    destinationItemContent: TreeViewItemContent,
    where: 'before' | 'inside' | 'after',
    animateFolder: (folder: gdFunctionFolderOrFunction) => void
  ): void;
  isDescendantOf(itemContent: TreeViewItemContent): boolean;
  getEventsFunctionsContainer(): ?gdEventsFunctionsContainer;
  getFunctionFolderOrFunction(): gdFunctionFolderOrFunction | null;
  getEventsFunction(): ?gdEventsFunction;
  getEventsBasedBehavior(): ?gdEventsBasedBehavior;
  getEventsBasedObject(): ?gdEventsBasedObject;
}
export type TreeItemProps = {|
  forceUpdate: () => void,
  forceUpdateList: () => void,
  unsavedChanges?: ?UnsavedChanges,
  forceUpdateEditor: () => void,
  preferences: Preferences,
  gdevelopTheme: GDevelopTheme,
  project: gdProject,
  eventsFunctionsExtension: gdEventsFunctionsExtension,
  editName: (itemId: string) => void,
  scrollToItem: (itemId: string) => void,
  showDeleteConfirmation: (
    options: ShowConfirmDeleteDialogOptions
  ) => Promise<boolean>,
|};
export type EventsFunctionsListInterface = {|
  forceUpdateList: () => void,
|};
