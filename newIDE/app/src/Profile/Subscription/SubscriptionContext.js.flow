    analyticsMetadata: SubscriptionAnalyticsMetadata,
    couponCode?: string,
    /** Called when the dialog closes itself to open the store, so the caller can close too. */
    onOpenStore?: () => void,
  |}) => void,
  /**
   * Returns the current coupon code being used, or null.
   */
