declare export default class Rectangle {
  left: number;
  right: number;
  top: number;
  bottom: number;
  zMin: number;
  zMax: number;
  constructor(left?: number, top?: number, right?: number, bottom?: number, zMin?: number, zMax?: number): void;
  static fromDOMRect(domRect: DOMRect | ClientRect): Rectangle;
  set(arg0: {
    left: number,
    top: number,
    right: number,
    bottom: number,
    zMin?: number,
    zMax?: number,
  }): void;
  setThroughCenter(arg0: {
    centerX: number,
    centerY: number,
    width: number,
    height: number,
  }): void;
  setRectangle(rectangle: Rectangle): void;
  width(): number;
  height(): number;
  depth(): number;
  centerX(): number;
  centerY(): number;
  centerZ(): number;
  union(rectangle: Rectangle): void;
  containsPoint(x: number, y: number): boolean;
  toCSSPosition(): { top: number, left: number, width: number, height: number };
  toString(): string;
