type ProjectCacheKey = {| userId: string, cloudProjectId: string |};

declare export default class ProjectCache {
  databasePromise: Promise<IDBDatabase> | null;
  static isAvailable(): any;
  static burst(): any;
  static _stringifyCacheKey(cacheKey: ProjectCacheKey): string;
  static _removeDatabaseIfCorrupt(): Promise<void>;
  _initializeDatabase(): any;
  _getEntry(cacheKey: ProjectCacheKey): any;
  get(cacheKey: ProjectCacheKey): Promise<string | null>;
  getCreationDate(cacheKey: ProjectCacheKey): Promise<number | null>;
  put(cacheKey: ProjectCacheKey, project: gdProject): Promise<void>;
}
