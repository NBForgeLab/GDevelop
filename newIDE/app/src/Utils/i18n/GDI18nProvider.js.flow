import * as React from 'react';
import { type I18n as I18nType } from '@lingui/core';

type Catalog = any;
type Catalogs = {
  [string]: Catalog,
};
type Props = {|
  language: string,
  children: React.Node,
|};
type State = {
  language: string,
  i18n: ?I18nType,
  catalogs: Catalogs,
};

declare export default class GDI18nProvider extends React.Component<Props, State> {
  state: State;
  _loadCatalog: (language: string) => Promise<Catalogs>;
  _loadLanguage(language: string): Promise<void>;
}
