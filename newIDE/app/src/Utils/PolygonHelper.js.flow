export type Polygon = Array<[number, number]>;
declare export function rotatePolygon(vertices: Polygon, centerX: number, centerY: number, angle: number): void;
declare export function flipPolygon(vertices: Polygon, centerX: number, centerY: number, flipX: boolean, flipY: boolean): void;
