// @flow
// @flow-transitional-stub [Phase 1]

export type PartialObjectDescription = {|
  reference: string,
  object: Object,
|};

export type Reference = {
  referenceTo: string,
};

export type SplitConfiguration = {|
  pathSeparator: string,
  getArrayItemReferenceName: (
    object: Object,
    currentReference: string
  ) => string,
  shouldSplit: (path: string) => boolean,
  isReferenceMagicPropertyName: string,
|};

export type UnsplitConfiguration = {|
  isReferenceMagicPropertyName: string,
  getReferencePartialObject: (referencePath: string) => Promise<Object>,
  maxUnsplitDepth?: number,
|};

declare export var split: (
  object: Object,
  configuration: SplitConfiguration
) => Array<PartialObjectDescription>;

declare export var unsplit: (
  object: Object,
  configuration: UnsplitConfiguration
) => Promise<void>;

declare export var splitPaths: (
  paths: Set<string>
) => (path: string) => boolean;

declare export var getNameFromProperty: (
  propertyName: string
) => (object: Object) => string;

declare export var getSlugifiedUniqueNameFromProperty: (
  propertyName: string
) => (object: Object, currentReference: string) => string;
