export type AppStoreProduct = {|
  type: 'RENEWING_SUBSCRIPTION' | 'NON_CONSUMABLE',
  name: string,

  productId: string,
  vendorId: string,

  price: string,

  hasIntroductoryPrice: boolean,
  introPrice: string,
  introPeriod: string,
  introDuration: string,
|};
declare export var hasAppStoreUserSubscription: () => boolean;
declare export var shouldUseAppStoreProduct: () => boolean;
declare export var getAppStoreProduct: (productId: string | null) => ?AppStoreProduct;
declare export var purchaseAppStoreProduct: (productId: string | null) => Promise<void>;
