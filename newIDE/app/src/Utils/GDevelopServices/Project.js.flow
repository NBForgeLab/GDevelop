// @flow
// @flow-transitional-stub
import { type AuthenticatedUser } from '../../Profile/AuthenticatedUserContext';
import { type FileMetadata } from '../../ProjectsStorage';

type CloudProject = {|
  id: string,
  name: string,
  createdAt: string,
  deletedAt?: string,
  updatedAt: string,
  currentVersion?: string,
  committedAt?: string,
  gameId?: string,
|};

declare export var CLOUD_PROJECT_NAME_MAX_LENGTH: number;
declare export var CLOUD_PROJECT_VERSION_LABEL_MAX_LENGTH: number;
declare export var PROJECT_RESOURCE_MAX_SIZE_IN_BYTES: any;
// $FlowFixMe[cannot-resolve-name]
declare export var projectResourcesClient: Axios;
// $FlowFixMe[cannot-resolve-name]
declare export var apiClient: Axios;
declare export var storeGDevelopResourceJwtToken: (token: string) => void;
declare export var getGDevelopResourceJwtToken: () => string | null;
declare export var cleanGDevelopResourceJwtToken: () => void;
declare export var addGDevelopResourceJwtTokenToUrl: (url: string) => string;
export type UploadedProjectResourceFiles = Array<{|
  error: ?Error,
  resourceFile: File,
  url: ?string,
|}>;
export type CloudProjectVersion = {|
  projectId: string,
  id: string,
  label?: string,
  createdAt: string,
  /** Was not always recorded so can be undefined. Represents the user who created this version. */
  userId?: string,
  /** previousVersion is null when the entity represents the initial version of a project. */
  previousVersion: null | string,
  /** If the version is a restoration from a previous one, this attribute is set. */
  restoredFromVersionId?: string,
|};
export type ExpandedCloudProjectVersion = {|
  projectId: string,
  id: string,
  label?: string,
  createdAt: string,
  /** Was not always recorded so can be undefined. Represents the user who created this version. */
  userId?: string,
  /** previousVersion is null when the entity represents the initial version of a project. */
  previousVersion: null | string,
  /** If the version is a restoration from a previous one, this attribute is set. */
  restoredFromVersion?: CloudProjectVersion,
|};
export type CloudProjectWithUserAccessInfo = {|
  ...CloudProject,
  /** Represents when the current user last modified the project. */
  lastModifiedAt: string,
  /** Was not always recorded so can be undefined. Represents the last user who committed. */
  lastCommittedBy?: string,
|};
export type Feature = 'ownership' | 'collaboration';
export type Level = 'owner' | 'writer' | 'reader';
export type ProjectUserAcl = {|
  projectId: string,
  userId: string,
  feature: Feature,
  level: Level,
|};
export type ProjectUserAclWithEmail = {|
  ...ProjectUserAcl,
  email: string,
|};
export type ProjectUserAclRequest = {|
  projectId: string,
  email: string, // The email of the user to add to the project.
  feature: Feature,
  level: Level,
|};
declare export var isCloudProjectVersionSane: (authenticatedUser: AuthenticatedUser, cloudProjectId: string, versionId: string) => Promise<boolean>;
declare export var getLastVersionsOfProject: (authenticatedUser: AuthenticatedUser, cloudProjectId: string) => Promise<?Array<ExpandedCloudProjectVersion>>;
declare export var getCredentialsForCloudProject: (authenticatedUser: AuthenticatedUser, cloudProjectId: string) => Promise<boolean>;
declare export var clearCloudProjectCredentials: () => Promise<void>;
declare export var getCloudProjectFileMetadataIdentifier: (storageProviderInternalName: string, fileMetadata: ?FileMetadata) => null | string;
declare export var createCloudProject: (authenticatedUser: AuthenticatedUser, cloudProjectCreationPayload: {| name: string, gameId: string |}) => Promise<?CloudProject>;
declare export var commitVersion: (arg0: {
  authenticatedUser: AuthenticatedUser,
  cloudProjectId: string,
  presignedUrl: string,
  zippedProject: Blob,
  previousVersion?: ?string,
  restoredFromVersionId?: ?string,
}) => Promise<?string>;
declare export var uploadProjectResourceFiles: (authenticatedUser: AuthenticatedUser, cloudProjectId: string, resourceFiles: File[], onProgress: (number, number) => void) => Promise<UploadedProjectResourceFiles>;
declare export var listUserCloudProjects: (getAuthorizationHeader: () => Promise<string>, userId: string) => Promise<Array<CloudProjectWithUserAccessInfo>>;
declare export var listOtherUserCloudProjects: (getAuthorizationHeader: () => Promise<string>, userId: string, otherUserId: string) => Promise<Array<CloudProjectWithUserAccessInfo>>;
declare export var getCloudProject: (authenticatedUser: AuthenticatedUser, cloudProjectId: string) => Promise<?CloudProjectWithUserAccessInfo>;
declare export var getOtherUserCloudProject: (authenticatedUser: AuthenticatedUser, cloudProjectId: string, otherUserId: string) => Promise<?CloudProject>;
declare export var updateCloudProject: (authenticatedUser: AuthenticatedUser, cloudProjectId: string, attributes: {| name?: string, gameId?: string |}) => Promise<?CloudProject>;
declare export var deleteCloudProject: (authenticatedUser: AuthenticatedUser, cloudProjectId: string) => Promise<?CloudProject>;
declare export var restoreCloudProject: (authenticatedUser: AuthenticatedUser, cloudProjectId: string) => Promise<?CloudProject>;
declare export var getPresignedUrlForVersionUpload: (authenticatedUser: AuthenticatedUser, cloudProjectId: string) => Promise<?string>;
declare export var getProjectFileAsZipBlob: (cloudProject: CloudProject | CloudProjectWithUserAccessInfo, versionId?: ?string) => Promise<Blob>;
declare export var extractDecodedFilenameFromProjectResourceUrl: (url: string) => string;
declare export var extractProjectUuidFromProjectResourceUrl: (url: string) => string | null;
declare export var createProjectUserAcl: (authenticatedUser: AuthenticatedUser, arg1: ProjectUserAclRequest) => Promise<?ProjectUserAclWithEmail>;
declare export var deleteProjectUserAcl: (authenticatedUser: AuthenticatedUser, arg1: ProjectUserAcl) => Promise<void>;
declare export var listProjectUserAcls: (authenticatedUser: AuthenticatedUser, arg1: {| projectId: string |}) => Promise<Array<ProjectUserAclWithEmail>>;
declare export var updateCloudProjectVersion: (authenticatedUser: AuthenticatedUser, cloudProjectId: string, versionId: string, attributes: {| label: string |}) => Promise<?CloudProjectVersion>;
declare export var listVersionsOfProject: (getAuthorizationHeader: () => Promise<string>, userId: ?string, cloudProjectId: string, options: {| forceUri: ?string |}) => Promise<?{|
  versions: Array<ExpandedCloudProjectVersion>,
  nextPageUri: ?string,
|}>;
declare export var getCloudProjectVersion: (getAuthorizationHeader: () => Promise<string>, arg1: {| userId: string, cloudProjectId: string, versionId: string |}) => Promise<?ExpandedCloudProjectVersion>;
