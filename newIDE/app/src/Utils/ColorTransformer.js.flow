// @flow
// @flow-transitional-stub [Phase 1]

export type RGBColor = {|
  r: number,
  g: number,
  b: number,
  a?: number,
|};

declare export var rgbColorToRGBString: (rgbColor: ?RGBColor) => string;
declare export var hexNumberToRGBArray: (
  hexNumber: number
) => [number, number, number];
declare export var rgbToHex: (r: number, g: number, b: number) => string;
declare export var rgbToHexNumber: (r: number, g: number, b: number) => number;
declare export var rgbStringToHexNumber: (rgbString: string) => number;
declare export var rgbStringToHexString: (rgbString: string) => string;
declare export var rgbOrHexToHexNumber: (value: string) => number;
declare export var hexNumberToRGBColor: (
  hexNumber: number
) => { a: number, b: number, g: number, r: number };
declare export var hexToRGBColor: (
  hex: string
) => { a: number, b: number, g: number, r: number };
declare export var rgbColorToHex: (r: number, g: number, b: number) => string;
declare export var hexNumberToRGBString: (hex: number) => string;
declare export var rgbOrHexToRGBString: (value: string) => string;
declare export var rgbStringAndAlphaToRGBColor: (
  rgbColor: string,
  alpha?: number
) => RGBColor | null;
declare export var hslToRgb: (h: number, s: number, l: number) => number[];
declare export var rgbToHsl: (r: number, g: number, b: number) => number[];
declare export var isLightRgbColor: (rgbColor: RGBColor) => boolean;
declare export var clampRgbComponent: (component: number) => number;
