import * as React from 'react';

type Props<SearchItem> = {|
  disableAutoTranslate?: boolean,
  searchItems: ?Array<SearchItem>,
  getSearchItemUniqueId: (item: SearchItem) => string,
  renderSearchItem: (
    item: SearchItem,
    onHeightComputed: (number) => void
