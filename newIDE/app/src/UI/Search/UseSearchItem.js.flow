// @flow
// @flow-transitional-stub
import { type ChosenCategory } from './FiltersChooser';
import {
  type AssetShortHeader,
  type PublicAssetPack,
  type ResourceV2,
  type Resource,
} from '../../Utils/GDevelopServices/Asset';
import {
  type PrivateAssetPackListingData,
  type PrivateGameTemplateListingData,
  type BundleListingData,
} from '../../Utils/GDevelopServices/Shop';

type SearchableItem =
  | AssetShortHeader
  | PublicAssetPack
  | ResourceV2
  | Resource
  | PrivateAssetPackListingData
  | PrivateGameTemplateListingData
  | BundleListingData;

export interface SearchFilter<SearchItem> {
  getPertinence(searchItem: SearchItem): number;
  hasFilters(): boolean;
}
declare export class TagSearchFilter<SearchItem: AssetShortHeader | ResourceV2> implements SearchFilter<SearchItem> {
  tags: Set<string>;
  constructor(tags?: Set<string>): void;
  getPertinence(searchItem: SearchItem): number;
  hasFilters(): boolean;
}
declare export var partialQuickSort: <Element: any>(searchItems: Array<Element>, getValue: (a: Element) => number, valueMin: number, valueMax: number) => void;
declare export var filterSearchItems: <SearchItem: SearchableItem>(searchItems: ?Array<SearchItem>, chosenCategory: ?ChosenCategory, chosenFilters: ?Set<string>, searchFilters?: Array<SearchFilter<SearchItem>>) => ?Array<SearchItem>;
declare export var useSearchItem: <SearchItem: SearchableItem>(searchItemsById: ?{ [string]: SearchItem }, getItemDescription: SearchItem => string, searchText: string, chosenCategory: ?ChosenCategory, chosenFilters: ?Set<string>, searchFilters?: Array<SearchFilter<SearchItem>>) => ?Array<SearchItem>;
