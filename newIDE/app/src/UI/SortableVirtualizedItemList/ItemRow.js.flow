// @flow
// @flow-transitional-stub
import * as React from 'react';
import { type MenuItemTemplate } from '../Menu/Menu.flow';
import { type HTMLDataset } from '../../Utils/HTMLDataset';

type Props<Item> = {|
  item: Item,
  itemName: string,
  id?: ?string,
  data?: HTMLDataset,
  isBold: boolean,
  onRename: string => void,
  editingName: boolean,
  getThumbnail?: () => string,
  renderItemLabel?: () => React.Node,
  selected: boolean,
  onItemSelected: (?Item, event?: ItemSelectionEvent) => void,
  errorStatus: '' | 'error' | 'warning',
  buildMenuTemplate: () => Array<MenuItemTemplate>,
  onEdit?: ?(Item) => void,
  hideMenuButton: boolean,
|};

export type ItemSelectionEvent = {|
  shiftKey: boolean,
  ctrlKey: boolean,
  metaKey: boolean,
|};
declare export default function ItemRow<Item>(arg0: Props<Item>): any;
