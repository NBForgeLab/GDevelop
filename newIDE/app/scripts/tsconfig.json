{
  "//": "TypeScript configuration for Node.js scripts in newIDE/app/scripts and shared CommonJS modules in newIDE/app/src.",
  "compilerOptions": {
    "noEmit": true,
    "allowJs": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "strictPropertyInitialization": true,
    "lib": ["DOM", "DOM.Iterable", "ES2020", "ES2021", "ES2022", "ESNext.Disposable"],
    "target": "ES2020",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "module": "esnext",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true
  },
  "include": [
    "**/*.js",
    "../src/GameEngineFinder/LocalGDJSFinder.js",
    "../src/JsExtensionsLoader/index.js",
    "../src/JsExtensionsLoader/LocalJsExtensionsFinder.js",
    "../src/JsExtensionsLoader/LocalJsExtensionsLoader.js",
    "../src/Utils/MapFor.js",
    "../src/Utils/OptionalRequire.js",
    "lib.es5.d.ts",
    "../src/types/gd-globals.d.ts",
    "../../../GDevelop.js/types.d.ts"
  ]
}
