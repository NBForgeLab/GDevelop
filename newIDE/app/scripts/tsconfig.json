{
  "//": "TypeScript configuration for Node.js scripts in newIDE/app/scripts and shared CommonJS modules in newIDE/app/src.",
  "compilerOptions": {
    "noEmit": true,
    "incremental": true,
    "tsBuildInfoFile": "../node_modules/.cache/typescript/scripts.tsbuildinfo",
    "allowJs": true,
    "checkJs": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "strictPropertyInitialization": true,
    "lib": ["DOM", "DOM.Iterable", "ES2020", "ES2021", "ES2022", "ESNext.Disposable"],
    "types": ["node"],
    "target": "ES2020",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "module": "esnext",
    "moduleResolution": "node",
    "paths": {
      "iso-639-1": ["./types/iso-639-1.d.ts"],
      "recursive-copy": ["./types/recursive-copy.d.ts"]
    },
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react"
  },
  "include": [
    "**/*.js",
    "**/*.mjs",
    "../src/GameEngineFinder/LocalGDJSFinder.js",
    "../src/JsExtensionsLoader/index.js",
    "../src/JsExtensionsLoader/LocalJsExtensionsFinder.js",
    "../src/JsExtensionsLoader/LocalJsExtensionsLoader.js",
    "../src/Utils/MapFor.js",
    "../src/Utils/OptionalRequire.js",
    "lib.es5.d.ts",
    "types.d.ts",
    "../src/types/*.d.ts",
    "../../../GDevelop.js/types.d.ts"
  ],
  "exclude": [
    "../public/libGD.js",
    "service-worker-template/**",
    "theme-templates/**"
  ]
}
