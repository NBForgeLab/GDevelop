{
  "sourceType": "unambiguous",
  "presets": [
    [
      "@babel/preset-env",
      {
        "targets": {
          "chrome": 100,
          "safari": 15,
          "firefox": 91
        }
      }
    ],
    "@babel/preset-react"
  ],
  "overrides": [
    {
      "test": ["**/*.js", "**/*.jsx"],
      "presets": ["@babel/preset-flow"]
    },
    {
      "test": ["**/*.ts", "**/*.tsx"],
      "presets": ["@babel/preset-typescript"]
    }
  ],
  "plugins": [
    "babel-plugin-macros"
  ]
}
