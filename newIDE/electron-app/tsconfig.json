{
  "//": "TypeScript configuration for GDevelop Electron app main process and build scripts.",
  "compilerOptions": {
    "noEmit": true,
    "allowJs": true,
    "checkJs": true,
    "strict": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "target": "ES2020",
    "lib": ["ES2020", "ES2021", "ES2022"],
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "electron": ["./node_modules/electron/electron.d.ts"]
    }
  },
  "include": [
    "electron-builder-config.js",
    "app/*.js",
    "app/Utils/*.js",
    "scripts/*.js",
    "types.d.ts"
  ],
  "exclude": [
    "node_modules",
    "app/node_modules",
    "app/extensions",
    "app/www",
    "dist"
  ]
}
